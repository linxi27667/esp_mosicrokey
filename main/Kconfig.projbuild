rsource "../third_party/xiaozhi/main/Kconfig.projbuild"

menu "MosiCrokey hardware"
choice MOSI_LCD_CONTROLLER
    prompt "TFT controller (128x160 portrait / 160x128 landscape)"
    default MOSI_LCD_ST7789
config MOSI_LCD_ST7789
    bool "ST7789"
config MOSI_LCD_ST7735
    bool "ST7735R"
endchoice
config MOSI_LCD_CLK
    int "TFT SCLK GPIO"
    default 43
config MOSI_LCD_MOSI
    int "TFT MOSI GPIO"
    default 44
config MOSI_LCD_CS
    int "TFT CS GPIO"
    default 45
config MOSI_LCD_DC
    int "TFT DC GPIO"
    default 46
config MOSI_LCD_RST
    int "TFT RESET GPIO"
    default 47
config MOSI_LCD_BL
    int "Backlight control GPIO (-1: module powered backlight)"
    range -1 61
    default -1
config MOSI_LCD_SPI_HZ
    int "TFT SPI clock in Hz"
    range 1000000 20000000
    default 10000000
config MOSI_LCD_X_OFFSET
    int "TFT horizontal offset"
    range 0 160
    default 0
config MOSI_LCD_Y_OFFSET
    int "TFT vertical offset"
    range 0 160
    default 0
config MOSI_LCD_INVERT
    bool "Invert panel colors"
    default n
config MOSI_LCD_BGR
    bool "Panel uses BGR color order"
    default y
config MOSI_LCD_ROTATE_180
    bool "Rotate landscape by 180 degrees"
    default n
config MOSI_LCD_BL_ACTIVE_LOW
    bool "Backlight control is active low"
    default n
endmenu
